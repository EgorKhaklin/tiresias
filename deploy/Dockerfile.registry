# The Tiresias registry server. It never receives raw data and never proves: it
# verifies each bundle's RISC Zero receipt with tiresias-prover, built here from
# zkvm/ (the pinned guest is embedded, so this build needs no Docker of its own).
FROM rust:1.99 AS prover
WORKDIR /src
COPY zkvm ./zkvm
RUN cargo build --release --locked --manifest-path zkvm/Cargo.toml -p tiresias-prover

FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml ./
COPY tiresias ./tiresias
RUN pip install --no-cache-dir .
COPY --from=prover /src/zkvm/target/release/tiresias-prover /usr/local/bin/tiresias-prover

ENV TIRESIAS_HOST=0.0.0.0 \
    TIRESIAS_PORT=8765 \
    TIRESIAS_DB=/data/registry.db \
    TIRESIAS_PROVER=/usr/local/bin/tiresias-prover \
    TIRESIAS_LOG_LEVEL=INFO

VOLUME ["/data"]
EXPOSE 8765

HEALTHCHECK --interval=30s --timeout=3s \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8765/healthz').status==200 else 1)"

CMD ["tiresias", "serve"]
